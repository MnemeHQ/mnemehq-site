{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "/home/you/.mneme-venv/bin/python \"/home/you/.mneme-venv/lib/python3.12/site-packages/mneme/integrations/codex_cli/hook.py\"", "timeout": 60 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          { "type": "command", "command": "/home/you/.mneme-venv/bin/python \"/home/you/.mneme-venv/lib/python3.12/site-packages/mneme/integrations/codex_cli/hook.py\"", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/home/you/.mneme-venv/bin/python \"/home/you/.mneme-venv/lib/python3.12/site-packages/mneme/integrations/codex_cli/hook.py\"", "timeout": 60 }
        ]
      }
    ]
  }
}
