# Development environment variables
# Copy to .env.local for local overrides

# API base URL for the audit backend
# Unset = same-origin (/api/...)
# Dev = http://localhost:8001
VITE_API_BASE=http://localhost:8001

# Optional emergency deployment/build kill switch. Changing it requires a rebuild and
# redeploy. Production defaults to enabled, but only https://mnemehq.com passes the host gate.
VITE_AUDIT_GTM_ENABLED=false
