# Build the backend from this same checkout first; see PREVIEW-CHECKLIST.md.
ARG BACKEND_IMAGE
FROM node:22-bookworm-slim AS frontend
WORKDIR /build/audit/frontend
COPY audit/frontend/package.json audit/frontend/package-lock.json ./
RUN npm ci
COPY audit/frontend/ ./
COPY site/ /build/site/
# Explicit '/' means same origin, overriding the production API fallback.
ENV VITE_API_BASE=/
RUN npm run build

FROM ${BACKEND_IMAGE} AS preview
COPY --from=frontend --chown=mneme:mneme /build/site/ /app/site/
ENV AUDIT_SITE_ROOT=/app/site
# A separate entry point: the normal production image/command is unchanged.
CMD ["sh", "-c", "exec python -m uvicorn app.preview:create_preview_app --factory --host 0.0.0.0 --port ${PORT}"]
